#!/usr/bin/env bash
set -euo pipefail

container_name=spider-kali
image_name=docker.io/kalilinux/kali-rolling

usage() {
  printf '%s\n' \
    "Spider OS Security Lab" \
    "Usage: spider-security-lab setup [headless|default|large]" \
    "       spider-security-lab enter" \
    "       spider-security-lab stop" \
    "       spider-security-lab status" \
    "       spider-security-lab reset" \
    "" \
    "Use only on systems you own or are explicitly authorized to assess."
}

require_podman() {
  if ! command -v podman >/dev/null 2>&1; then
    printf '%s\n' "Podman is required but not installed."
    exit 1
  fi
}

container_exists() {
  podman container exists "$container_name"
}

setup_lab() {
  profile=headless
  if [ "$#" -gt 0 ]; then
    profile="$1"
  fi
  case "$profile" in
    headless) metapackage=kali-linux-headless ;;
    default) metapackage=kali-linux-default ;;
    large) metapackage=kali-linux-large ;;
    *)
      printf '%s\n' "Unknown profile: $profile"
      exit 2
      ;;
  esac
  if container_exists; then
    printf '%s\n' "The Spider Kali lab already exists."
    exit 0
  fi

  podman pull "$image_name"
  podman create \
    --name "$container_name" \
    --hostname spider-kali \
    --security-opt no-new-privileges \
    --cap-drop all \
    --cap-add net_raw \
    --pids-limit 2048 \
    --memory 8g \
    "$image_name" \
    sleep infinity
  podman start "$container_name"
  podman exec "$container_name" sh -lc \
    "apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y $metapackage && apt-get clean"
  printf '%s\n' \
    "Security Lab installed with $metapackage." \
    "It has no host folders mounted. Use 'spider-security-lab enter' to open it."
}

enter_lab() {
  if ! container_exists; then
    printf '%s\n' "Run 'spider-security-lab setup' first."
    exit 1
  fi
  podman start "$container_name" >/dev/null
  podman exec -it "$container_name" bash
}

reset_lab() {
  if ! container_exists; then
    printf '%s\n' "The Security Lab does not exist."
    exit 0
  fi
  printf '%s' "Delete the entire Spider Kali container and its installed tools? Type RESET: "
  read -r answer
  if [ "$answer" != "RESET" ]; then
    printf '%s\n' "Reset canceled."
    exit 1
  fi
  podman rm --force "$container_name"
  printf '%s\n' "Security Lab container removed."
}

require_podman
command_name=help
if [ "$#" -gt 0 ]; then
  command_name="$1"
  shift
fi

case "$command_name" in
  setup) setup_lab "$@" ;;
  enter) enter_lab ;;
  stop) podman stop "$container_name" ;;
  status) podman ps --all --filter "name=$container_name" ;;
  reset) reset_lab ;;
  help|-h|--help) usage ;;
  *)
    usage
    exit 2
    ;;
esac

