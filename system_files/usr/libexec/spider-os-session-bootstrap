#!/usr/bin/env bash
set -u

log_dir="$HOME/.local/state/spider-os"
mkdir -p "$log_dir"
exec >>"$log_dir/session-bootstrap.log" 2>&1

echo "=== Spider OS session bootstrap $(date --iso-8601=seconds) ==="

# KDE owns the graphical session. Import that environment into the user
# systemd manager before starting resident services that may use desktop APIs.
systemctl --user import-environment \
  DISPLAY \
  WAYLAND_DISPLAY \
  XDG_CURRENT_DESKTOP \
  XDG_SESSION_DESKTOP \
  XDG_SESSION_TYPE \
  DBUS_SESSION_BUS_ADDRESS || true

systemctl --user reset-failed spider-os.service spider-ai-resident.service || true
systemctl --user start spider-os.service

# The Web is the session foundation. Do not continue until its local API is
# actually answering, but keep the desktop usable if startup fails.
web_ready=0
for _ in $(seq 1 60); do
  if curl --fail --silent --max-time 2 http://127.0.0.1:8765/api/health >/dev/null 2>&1; then
    web_ready=1
    break
  fi
  sleep 1
done

if [ "$web_ready" -ne 1 ]; then
  echo "The Web core did not become healthy within 60 seconds."
  systemctl --user --no-pager --full status spider-os.service || true
  journalctl --user -b -u spider-os.service --no-pager -n 200 || true
  exit 1
fi

/usr/bin/spider-os-first-login
/usr/bin/spider-os-open --session || true
systemctl --user start spider-ai-resident.service

echo "Spider OS session bootstrap complete."
