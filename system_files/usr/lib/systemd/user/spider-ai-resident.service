[Unit]
Description=Web always-on resident intelligence
After=spider-os.service sound.target
Wants=spider-os.service

[Service]
Type=simple
ExecStart=/usr/bin/spider-os resident --interval 5
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
Environment="SPIDER_AI_WAKE_PHRASES=Hey Webbie;Webbie;Hey Web;Web"
Environment=SPIDER_OS_PROACTIVE=1
Environment="SPIDER_OS_WAKE_PHRASES=Hey Web,Web"

Environment="SPIDER_OS_PROACTIVE_LEVEL=very-high"
Environment="SPIDER_OS_ATTENTION_STYLE=cue-then-speak"
Environment="SPIDER_OS_VISUAL_PRESENCE=taskbar+edge-orb"
Environment="SPIDER_OS_SCREEN_AWARENESS=1"
Environment="SPIDER_OS_SCREEN_ARCHIVE=0"
Environment="SPIDER_OS_MEMORY_LEARNING=transparent"

[Install]
WantedBy=default.target
