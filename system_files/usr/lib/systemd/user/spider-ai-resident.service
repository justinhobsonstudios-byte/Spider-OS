[Unit]
Description=Webbie resident KDE intelligence
PartOf=graphical-session.target
After=spider-os.service spider-searxng.service
Wants=spider-os.service spider-searxng.service

[Service]
Type=simple
ExecStart=/usr/bin/spider-os resident --interval 5
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
Environment=SPIDER_OS_VOICE_ENABLED=1
Environment=SPIDER_OS_PROACTIVE=1
Environment="SPIDER_OS_WAKE_PHRASES=Hey Webbie,Webbie,Hey Web,Web"

Environment="SPIDER_OS_PROACTIVE_LEVEL=very-high"
Environment="SPIDER_OS_ATTENTION_STYLE=cue-then-speak"
Environment="SPIDER_OS_VISUAL_PRESENCE=taskbar+edge-orb"
Environment="SPIDER_OS_SCREEN_AWARENESS=1"
Environment="SPIDER_OS_SCREEN_ARCHIVE=0"
Environment="SPIDER_OS_MEMORY_LEARNING=transparent"

[Install]
WantedBy=graphical-session.target
