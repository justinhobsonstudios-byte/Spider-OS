[Unit]
Description=Spider OS local SearXNG research engine
PartOf=graphical-session.target
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStartPre=/usr/bin/spider-searxng-prepare
ExecStart=/usr/bin/podman run --rm --replace --name spider-searxng --pull=missing --publish 127.0.0.1:8888:8080 --volume %h/.config/spider-os/searxng:/etc/searxng:Z docker.io/searxng/searxng:latest
ExecStop=/usr/bin/podman stop --ignore --time 10 spider-searxng
Restart=on-failure
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=graphical-session.target

