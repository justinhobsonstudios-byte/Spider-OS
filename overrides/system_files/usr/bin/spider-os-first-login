#!/bin/sh
set -eu

config_root="$HOME/.config/spider-os"
state_root="${XDG_STATE_HOME:-$HOME/.local/state}/spider-os"
marker="$config_root/desktop-initialized"
setup_log="$state_root/setup.log"
mkdir -p "$config_root" "$state_root"
chmod 700 "$config_root" "$state_root" 2>/dev/null || true
umask 077

wallpaper=/usr/share/wallpapers/SpiderOS/contents/images/1920x1080.svg
if [ ! -f "$marker" ]; then
  if command -v plasma-apply-wallpaperimage >/dev/null 2>&1 && [ -f "$wallpaper" ]; then
    plasma-apply-wallpaperimage "$wallpaper" >/dev/null 2>&1 || true
  fi
  if command -v kwriteconfig6 >/dev/null 2>&1; then
    kwriteconfig6 --file kdeglobals --group General --key ColorScheme BreezeDark
  fi
  : > "$marker"
fi

# First boot is not complete until Spider Setup reports complete=true. Merely
# creating setup.json is not enough: an interrupted wizard must reopen on the
# next login instead of silently stranding the user with half-written choices.
setup_complete=0
if /usr/bin/spider-os setup --status 2>/dev/null | grep -Eq '"complete"[[:space:]]*:[[:space:]]*true'; then
  setup_complete=1
fi

if [ "$setup_complete" -ne 1 ]; then
  # Do not block Plasma startup on the wizard. Keep logs in the user's private
  # XDG state directory rather than a world-visible /tmp file.
  (sleep 2; /usr/bin/spider-os setup) >"$setup_log" 2>&1 &
fi
