[Unit]
Description=Spider OS Web Assembly
Before=spider-ai-resident.service
Wants=spider-os.service
After=spider-os.service

[Service]
Type=oneshot
ExecStart=/usr/bin/spider-os assembly run
RemainAfterExit=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=default.target
