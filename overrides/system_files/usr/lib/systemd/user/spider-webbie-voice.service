[Unit]
Description=Webbie always-on local voice presence
Wants=spider-os.service spider-web-assembly.service spider-ai-resident.service
After=spider-os.service spider-web-assembly.service spider-ai-resident.service sound.target

[Service]
Type=simple
ExecStart=/usr/bin/spider-os voice listen
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
