#!/usr/bin/env python3
"""Minimal Spider OS 1.0 Weave bootstrap daemon.

This foundation service intentionally exposes only read-only health information.
Privileged capabilities and the full permission broker are added in later phases.
"""

from __future__ import annotations

import json
import os
import signal
import socket
import sys
from pathlib import Path

SOCKET_PATH = Path("/run/spider-os/weave.sock")
VERSION = "0.1-foundation"
running = True


def stop(_signum: int, _frame: object) -> None:
    global running
    running = False


def reply(request: dict[str, object]) -> dict[str, object]:
    operation = request.get("op")
    if operation in {"health", "ping"}:
        return {
            "ok": True,
            "service": "the-weave",
            "version": VERSION,
            "mode": "foundation",
            "capabilities": ["weave.health"],
        }
    return {
        "ok": False,
        "error": "unknown-operation",
        "allowed": ["health", "ping"],
    }


def main() -> int:
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    SOCKET_PATH.parent.mkdir(parents=True, exist_ok=True)
    try:
        SOCKET_PATH.unlink()
    except FileNotFoundError:
        pass

    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(SOCKET_PATH))
    # Foundation endpoint is health-only. Capability mutations do not exist here.
    os.chmod(SOCKET_PATH, 0o666)
    server.listen(8)
    server.settimeout(1.0)

    print(f"The Weave {VERSION} listening on {SOCKET_PATH}", flush=True)

    while running:
        try:
            connection, _ = server.accept()
        except TimeoutError:
            continue
        except OSError:
            if running:
                raise
            break

        with connection:
            raw = connection.recv(65536)
            try:
                request = json.loads(raw.decode("utf-8") or "{}")
                if not isinstance(request, dict):
                    raise ValueError("request is not an object")
                response = reply(request)
            except Exception as exc:  # malformed local request, never fatal to daemon
                response = {"ok": False, "error": "invalid-request", "detail": str(exc)}
            connection.sendall((json.dumps(response, separators=(",", ":")) + "\n").encode("utf-8"))

    server.close()
    try:
        SOCKET_PATH.unlink()
    except FileNotFoundError:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
