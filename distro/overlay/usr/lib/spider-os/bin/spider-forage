#!/usr/bin/env python3
"""Local Forage storage bootstrap.

Phase one creates the private index store and keeps the resident service alive.
Actual file parsers, semantic search and Deep Forage are layered on this stable
storage boundary instead of being baked into the desktop shell.
"""

from __future__ import annotations

import os
import signal
import sqlite3
import time
from pathlib import Path

running = True


def stop(_signum: int, _frame: object) -> None:
    global running
    running = False


def data_root() -> Path:
    home = Path.home()
    base = Path(os.environ.get("XDG_DATA_HOME", home / ".local" / "share"))
    root = base / "spider-os" / "forage"
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    return root


def initialize_database(path: Path) -> None:
    with sqlite3.connect(path) as db:
        db.executescript(
            """
            PRAGMA journal_mode=WAL;
            CREATE TABLE IF NOT EXISTS schema_info (
                version INTEGER NOT NULL,
                created_at INTEGER NOT NULL
            );
            INSERT INTO schema_info(version, created_at)
            SELECT 1, strftime('%s','now')
            WHERE NOT EXISTS (SELECT 1 FROM schema_info);

            CREATE TABLE IF NOT EXISTS documents (
                id INTEGER PRIMARY KEY,
                uri TEXT NOT NULL UNIQUE,
                title TEXT,
                mime_type TEXT,
                modified_ns INTEGER,
                privacy TEXT NOT NULL DEFAULT 'standard'
            );

            CREATE TABLE IF NOT EXISTS activity (
                id INTEGER PRIMARY KEY,
                event_type TEXT NOT NULL,
                uri TEXT,
                happened_at INTEGER NOT NULL
            );
            """
        )


def main() -> int:
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    db_path = data_root() / "forage.sqlite3"
    initialize_database(db_path)
    while running:
        time.sleep(5)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
