[Unit]
Description=Spider OS Forage local index service
Documentation=https://github.com/justinhobsonstudios-byte/Spider-OS
After=default.target

[Service]
Type=simple
ExecStart=/usr/lib/spider-os/bin/spider-forage
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict

[Install]
WantedBy=default.target
