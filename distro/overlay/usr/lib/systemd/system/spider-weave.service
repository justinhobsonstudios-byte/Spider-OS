[Unit]
Description=Spider OS The Weave foundation service
Documentation=https://github.com/justinhobsonstudios-byte/Spider-OS
After=local-fs.target
Before=display-manager.service

[Service]
Type=simple
ExecStart=/usr/lib/spider-os/bin/spider-weave
Restart=on-failure
RestartSec=2s
DynamicUser=yes
RuntimeDirectory=spider-os
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
